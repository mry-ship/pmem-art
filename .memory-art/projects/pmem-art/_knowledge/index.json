    "palette-70-20-10": {
      "id": "palette-70-20-10",
      "title": "色彩构成：70-20-10 色板比例黄金法则",
      "body": "画面色彩严格遵循 70% 主导底色（稳住大体量与环境基调）、20% 辅助次色（区分结构层级与透气过渡）、10% 高对比点缀色（仅用于视觉中心与核心识别锚点）；严禁未经授权的高饱和荧光/霓虹杂色乱入破坏色调统一。",
      "tags": [
        "brand",
        "color_palette",
        "character",
        "scene",
        "ui"
      ],
      "source": "learn_accept",
      "layer_scope": "private",
      "project_id": "pmem-art",
      "project_name": "pmem-art",
      "universal": true,
      "promoted_to_shared": true,
      "updated_at": "2026-11-05 20:41:42 UTC+8"
    },
    "material-surface-physics": {
      "id": "material-surface-physics",
      "title": "材质表现：金属/织物/陶瓷高光形状与粗糙度区分",
      "body": "不同材质必须通过高光锐度与菲涅尔反射率严格拉开质感：金属具备高对比硬边高光与环境反光，哑光织物采用宽缓漫反射柔光，釉面/玉石保留温润半透明次表面散射；严禁全图使用同质化油腻塑料感高光。",
      "tags": [
        "brand",
        "material",
        "character",
        "ui"
      ],
      "source": "learn_accept",
      "layer_scope": "private",
      "project_id": "pmem-art",
      "project_name": "pmem-art",
      "universal": true,
      "promoted_to_shared": true,
      "updated_at": "2026-11-05 20:41:46 UTC+8"
    },
    "anatomy-head-ratio": {
      "id": "anatomy-head-ratio",
      "title": "人体结构：头身比尺规与重心控制",
      "body": "写实/二次元立绘标准锁定 7~8 头身（常用 7.5 头身），Q版锁定 2~3 头身；草图阶段必须先标头顶、下巴、胸线、胯部、膝盖五道刻度线并校核重心垂线，严禁头肩比例失调或幼态大头漂移。",
      "tags": [
        "anatomy",
        "character",
        "composition"
      ],
      "source": "learn_accept",
      "layer_scope": "private",
      "project_id": "pmem-art",
      "project_name": "pmem-art",
      "universal": true,
      "promoted_to_shared": true,
      "updated_at": "2026-11-05 20:41:48 UTC+8"
    },
    "eye-hierarchy": {
      "id": "eye-hierarchy",
      "title": "人体结构：五官主次与第一识别锚点",
      "body": "先定十字中线、眼位与眉弓转折，再定鼻底与唇裂；角色标志性面部特征（如单侧眼镜、异色瞳、机械义眼、面部纹印）必须作为第一识别锚点显式锁定高权重，严禁漏画或左右镜像翻转。",
      "tags": [
