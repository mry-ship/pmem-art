# 复制为 vlm_judge.local.yaml 后填写（该文件已被 .gitignore，勿提交）
#   cp .memory-art/vlm_judge.local.yaml.example .memory-art/vlm_judge.local.yaml
#
# 也可用环境变量（任选其一）：
#   export PMEM_VLM_API_KEY=sk-...
#   export OPENAI_API_KEY=sk-...
#   export ANTHROPIC_API_KEY=sk-ant-...

vlm_judge:
  enabled: auto
  provider: openai          # openai | openai_compatible | anthropic
  api_key: ""               # 填这里或只靠环境变量
  api_key_env: PMEM_VLM_API_KEY
  base_url: ""              # OpenAI 兼容中转：https://your-gateway/v1
  model: gpt-4o
  timeout_sec: 90
  on_error: fallback
  write_sidecar: true
