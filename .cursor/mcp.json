{
  "mcpServers": {
    "pmem-art": {
      "command": "py",
      "args": [
        "-3",
        "pmem_art.py",
        "serve",
        "--root",
        "${workspaceFolder}"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "pmem": {
      "command": "pmem",
      "args": [
        "serve",
        "--root",
        "${workspaceFolder}"
      ]
    }
  }
}
