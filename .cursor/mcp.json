{
  "mcpServers": {
    "pmem-art": {
      "command": "python3",
      "args": [
        "pmem_art.py",
        "serve",
        "--root",
        "${workspaceFolder}"
      ]
    },
    "pmem": {
      "command": "pmemw",
      "args": [
        "serve",
        "--root",
        "${workspaceFolder}"
      ]
    }
  }
}
