{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "pythonw -u pmem_art.py hook pre-gen",
        "matcher": "GenerateImage",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "pythonw -u pmem_art.py hook post-asset",
        "matcher": "GenerateImage"
      }
    ]
  }
}
