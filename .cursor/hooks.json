{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "pyw -3 -u pmem_art.py hook pre-gen",
        "matcher": "GenerateImage",
        "failClosed": false
      },
      {
        "command": "pyw -3 -u art_shell_hook.py",
        "matcher": "Shell",
        "failClosed": false
      },
      {
        "command": "pmemw hook pre-tool",
        "matcher": "Write|StrReplace|Edit|MultiEdit|EditNotebook|Delete|MCP|record_memory|search_memory",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "pyw -3 -u pmem_art.py hook post-asset",
        "matcher": "GenerateImage"
      }
    ],
    "stop": [
      {
        "command": "pyw -3 -u pmem_art.py hook stop",
        "loop_limit": 8
      }
    ],
    "afterMCPExecution": [
      {
        "command": "pmemw hook after-mcp"
      }
    ]
  }
}
