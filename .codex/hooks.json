{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "GenerateImage",
        "hooks": [
          {
            "type": "command",
            "command": "pyw -3 -u pmem_art.py hook pre-gen",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(Bash|apply_patch|mcp__pmem__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "pmemw hook pre-tool --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "GenerateImage",
        "hooks": [
          {
            "type": "command",
            "command": "pyw -3 -u pmem_art.py hook post-asset",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(Bash|apply_patch|mcp__pmem__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "pmemw hook post-tool --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pmemw hook prompt --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pmemw hook stop --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pmemw hook compact --agent codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
